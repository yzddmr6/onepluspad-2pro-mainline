"""Discard only the fixture namespace; never invoke host snapd helpers."""
import json
import os
from pathlib import Path
import sys
root = Path(os.environ['SNAP_GRAPHICS_FIXTURE'])
state = json.loads((root / 'state.json').read_text())
consumer, = sys.argv[1:]
with (root / 'calls.jsonl').open('a') as stream:
    stream.write(json.dumps({'args': ['discard-ns', consumer]}) + '\n')
if state.get('fail_discard') == consumer:
    sys.exit('fixture: discard failed')
state.setdefault('mounts', {})[consumer] = None
(root / 'state.json').write_text(json.dumps(state, indent=2) + '\n')
