[Unit]
Description=Explicitly enabled USB NCM diagnostics
ConditionKernelCommandLine=erhai.debug=1
ConditionPathExistsGlob=/sys/class/udc/*
After=local-fs.target
Wants=erhai-debug-ssh.service erhai-debug-dhcp.service
Before=erhai-debug-ssh.service erhai-debug-dhcp.service

[Service]
Type=notify
NotifyAccess=all
RuntimeDirectory=erhai-debug
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=erhai-debug "--why=USB developer connection is enabled" /usr/libexec/erhai-ncm serve ${NOTIFY_SOCKET}
ExecStop=/usr/libexec/erhai-ncm stop

[Install]
WantedBy=multi-user.target
