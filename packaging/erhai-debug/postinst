#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e
if [ "$1" = configure ]; then
    deb-systemd-helper unmask erhai-debug.service >/dev/null || true
    deb-systemd-helper enable erhai-debug.service >/dev/null
    if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
    # Deactivate obsolete listeners on upgrade. Package installation must
    # complete from a local session or an independent systemd unit.
    if [ -d /run/systemd/system ] && [ -n "${2:-}" ]; then
        for old in erhai-debug-http.service erhai-debug-shell.service; do
            if systemctl is-active --quiet "$old"; then systemctl stop "$old"; fi
        done
    fi
fi
