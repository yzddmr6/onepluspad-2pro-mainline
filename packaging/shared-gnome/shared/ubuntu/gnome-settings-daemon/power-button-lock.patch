+/* SetActive alone does not lock GNOME Shell. Request Lock first, just as
+ * the screen-lock shortcut does, and never fall back to suspend on failure.
+ */
+static void
+on_power_screen_active (GObject      *source,
+                        GAsyncResult *result,
+                        gpointer      user_data)
+{
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GVariant) reply = NULL;
+
+        reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+        if (reply == NULL && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+                g_warning ("Couldn't activate screen saver: %s", error->message);
+}
+
+static void
+on_power_screen_locked (GObject      *source,
+                        GAsyncResult *result,
+                        gpointer      user_data)
+{
+        g_autoptr(GCancellable) cancellable = user_data;
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GVariant) reply = NULL;
+
+        reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+        if (reply == NULL) {
+                if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+                        g_warning ("Couldn't lock screen: %s", error->message);
+                return;
+        }
+
+        if (!g_cancellable_is_cancelled (cancellable))
+                g_dbus_proxy_call (G_DBUS_PROXY (source), "SetActive",
+                                   g_variant_new ("(b)", TRUE),
+                                   G_DBUS_CALL_FLAGS_NONE, -1, cancellable,
+                                   on_power_screen_active, NULL);
+}
+
+static void
+do_power_lock_action (GsdMediaKeysManager *manager,
+                      gboolean             in_lock_screen)
+{
+        GsdMediaKeysManagerPrivate *priv = GSD_MEDIA_KEYS_MANAGER_GET_PRIVATE (manager);
+        g_autoptr(GSettings) lockdown = NULL;
+
+        /* Mutter input activity and gsd-power's existing user-active watch
+         * wake a blank display. Do not re-activate or unlock the screen saver.
+         */
+        if (in_lock_screen)
+                return;
+
+        lockdown = g_settings_new ("org.gnome.desktop.lockdown");
+        if (g_settings_get_boolean (lockdown, "disable-lock-screen"))
+                return;
+
+        if (priv->screen_saver_proxy == NULL)
+                priv->screen_saver_proxy = gnome_settings_bus_get_screen_saver_proxy ();
+
+        g_dbus_proxy_call (G_DBUS_PROXY (priv->screen_saver_proxy), "Lock", NULL,
+                           G_DBUS_CALL_FLAGS_NONE, -1, priv->bus_cancellable,
+                           on_power_screen_locked, g_object_ref (priv->bus_cancellable));
+}
