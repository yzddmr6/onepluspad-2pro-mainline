      "name": "libssc",
      "version": "0.4.4",
      "url": "https://codeberg.org/DylanVanAssche/libssc/archive/0cf77b93b55752da34dca2dcecc06fca8665184b.tar.gz",
      "mirror_url": "http://deb.debian.org/debian/pool/main/libs/libssc/libssc_0.4.4.orig.tar.gz",
