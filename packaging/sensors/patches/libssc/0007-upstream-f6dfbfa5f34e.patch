From f6dfbfa5f34ef22f3d47ef346c22834e79c60df1 Mon Sep 17 00:00:00 2001
From: Felix <felix@niederer.dev>
Date: Sun, 26 Jul 2026 10:12:28 +0200
Subject: [PATCH] sensor: use g_autoptr for the task in open/close callbacks

---
 src/libssc-sensor-accelerometer.c | 8 ++------
 src/libssc-sensor-compass.c       | 8 ++------
 src/libssc-sensor-gyroscope.c     | 8 ++------
 src/libssc-sensor-light.c         | 8 ++------
 src/libssc-sensor-magnetometer.c  | 8 ++------
 src/libssc-sensor-proximity.c     | 8 ++------
 6 files changed, 12 insertions(+), 36 deletions(-)

diff --git a/src/libssc-sensor-accelerometer.c b/src/libssc-sensor-accelerometer.c
index a955d35..8579af0 100644
--- a/src/libssc-sensor-accelerometer.c
+++ b/src/libssc-sensor-accelerometer.c
@@ -112,17 +112,15 @@ report_received (SSCClient *self, guint32 msg_id, guint64 uid_high, guint64 uid_
 static void
 accelerometer_close_ready (SSCSensor *sensor, GAsyncResult *result, gpointer user_data)
 {
-	GTask *task = G_TASK (user_data);
+	g_autoptr (GTask) task = G_TASK (user_data);
 	g_autoptr (GError) error = NULL;
 
 	if (!SSC_SENSOR_CLASS (ssc_sensor_accelerometer_parent_class)->close_finish (sensor, result, &error)) {
 		g_task_return_error (task, g_steal_pointer (&error));
-		g_object_unref (task);
 		return;
 	}
 
 	g_task_return_boolean (task, TRUE);
-	g_object_unref (task);
 }
 
 gboolean
@@ -176,17 +174,15 @@ ssc_sensor_accelerometer_close_sync (SSCSensorAccelerometer *self, GCancellable
 static void
 accelerometer_open_ready (SSCSensor *sensor, GAsyncResult *result, gpointer user_data)
 {
-	GTask *task = G_TASK (user_data);
+	g_autoptr (GTask) task = G_TASK (user_data);
 	g_autoptr (GError) error = NULL;
 
 	if (!SSC_SENSOR_CLASS (ssc_sensor_accelerometer_parent_class)->open_finish (sensor, result, &error)) {
 		g_task_return_error (task, g_steal_pointer (&error));
-		g_object_unref (task);
 		return;
 	}
 
 	g_task_return_boolean (task, TRUE);
-	g_object_unref (task);
 }
 
 gboolean
