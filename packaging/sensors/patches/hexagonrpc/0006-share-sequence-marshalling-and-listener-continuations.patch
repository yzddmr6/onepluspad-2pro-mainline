@@ -168,6 +168,12 @@ int inbuf_decode_is_complete(struct fastrpc_decoder_context *ctx)
 	return ctx->idx >= ctx->n_inbufs;
 }
 
+void inbuf_decode_abort(struct fastrpc_decoder_context *ctx)
+{
+	iobuf_free(ctx->n_inbufs, ctx->inbufs);
