From 8e87805ac5a0c192b9df4a71d02bc199235c34f1 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Fri, 25 Sep 2026 20:10:00 +0800
Subject: [PATCH] hexagonrpcd: keep listening after refusing a request

When the remote process invokes a handle or method that hexagonrpcd does
not implement, or sends scalars or buffer sizes that do not match the
method definition, the listener leaves its loop and hexagonrpcd exits.
Upstream does this because a refused request has no output buffers to
encode, and a dead tunnel makes a missing method impossible to overlook.
On the SM8750 ADSP sensor domain the cost is that one unimplemented call,
a second after attach, leaves every later file request of the domain
unanswered for the rest of the boot: the domain cannot be restarted
without restarting the ADSP, which also runs audio and USB-C.

Qualcomm's reference listener (quic/fastrpc, listener_android.c) answers
any failed request with its result code and empty output buffers and
waits for the next request; its generated skels return AEE_EUNSUPPORTED
for unknown methods. Do the same: reply to a refused request with the
error set by the dispatcher and no output buffers, log the refusal next
to the existing reason, and keep serving. Transport failures (fetching or
decoding a request) still end the listener.

The risk is that a refused call now degrades the remote process instead
of stopping the file server: a caller that treats the error as fatal may
fail later and further from the cause, and a missing method is only
visible in the log. The "Unsupported method" and "Refused request" lines
stay on stderr so a bring-up check can require their absence.

Drive the listener loop through a scripted remote side in a host test:
an unknown method, a method 36 lookup, an unknown handle and a wrong
scalar shape must each be answered, the refusals without output buffers,
until the tunnel is torn down.

Assisted-by: LLM
---
 hexagonrpcd/listener.c        |  24 ++++-
 tests/meson.build             |  18 ++++
 tests/test_listener_refusal.c | 183 ++++++++++++++++++++++++++++++++++
 3 files changed, 221 insertions(+), 4 deletions(-)
 create mode 100644 tests/test_listener_refusal.c

diff --git a/hexagonrpcd/listener.c b/hexagonrpcd/listener.c
index 20d72b7..1cc064b 100644
--- a/hexagonrpcd/listener.c
+++ b/hexagonrpcd/listener.c
@@ -431,7 +431,12 @@ static int return_for_next_invoke(int fd,
 	uint32_t outbufs_len;
 	int ret;
 
-	outbufs_len = outbufs_calculate_size(REMOTE_SCALARS_OUTBUFS(*sc), returned);
+	/* A refused request is answered with its error and no output buffers. */
+	if (returned != NULL)
+		outbufs_len = outbufs_calculate_size(REMOTE_SCALARS_OUTBUFS(*sc),
+						     returned);
+	else
+		outbufs_len = 0;
 
 	if (outbufs_len) {
 		outbufs = malloc(outbufs_len);
@@ -595,12 +600,23 @@ int run_fastrpc_listener(int fd,
 
 		if (returned != NULL)
 			iobuf_free(n_outbufs, returned);
-
+		returned = NULL;
+
+		/*
+		 * A request that no handler accepts (unknown handle or method,
+		 * wrong scalars or sizes) only fails that request: reply with
+		 * the error code and no output buffers, like the reference
+		 * listener does, and keep serving. Leaving would strand every
+		 * later file request of the remote process.
+		 */
 		ret = fastrpc_invoke_requested_procedure(n_ifaces, ifaces,
 							 handle, sc, &result,
 							 decoded, &returned);
-		if (ret)
-			break;
+		if (ret) {
+			fprintf(stderr, "Refused request on handle %u (%08x) with %u\n",
+					handle, sc, result);
+			ret = 0;
+		}
 
 		if (decoded != NULL)
 			iobuf_free(REMOTE_SCALARS_INBUFS(sc), decoded);
diff --git a/tests/meson.build b/tests/meson.build
index 7d19c4a..9c12fd5 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -80,6 +80,22 @@ test_apps_std_fd = executable('test_apps_std_fd',
   include_directories : include,
 )
 
+test_listener_refusal = executable('test_listener_refusal',
+  'test_listener_refusal.c',
+  '../hexagonrpcd/apps_std.c',
+  '../hexagonrpcd/interface/adsp_listener.c',
+  '../hexagonrpcd/interface/apps_std.c',
+  '../hexagonrpcd/hexagonfs.c',
+  '../hexagonrpcd/hexagonfs_mapped.c',
+  '../hexagonrpcd/hexagonfs_plat_subtype_name.c',
+  '../hexagonrpcd/hexagonfs_virt_dir.c',
+  '../hexagonrpcd/iobuffer.c',
+  '../hexagonrpcd/listener.c',
+  '../hexagonrpcd/rpcd_builder.c',
+  c_args : cflags,
+  include_directories : include,
+)
+
 test('iobuffer', test_iobuffer)
 test('hexagonfs', test_hexagonfs, args : [sample_file])
 test('hexagonrpc', test_hexagonrpc)
@@ -90,3 +106,5 @@ test('odm-sensor-config', test_odm_sensor_config,
 test('sns-registry', test_sns_registry)
 test('apps-std-fd', test_apps_std_fd,
   args : [meson.current_build_dir() / 'apps-std-fd'])
+test('listener-refusal', test_listener_refusal,
+  args : [meson.current_build_dir() / 'listener-refusal'])
diff --git a/tests/test_listener_refusal.c b/tests/test_listener_refusal.c
new file mode 100644
index 0000000..2437897
--- /dev/null
+++ b/tests/test_listener_refusal.c
@@ -0,0 +1,183 @@
+#include <endian.h>
+#include <errno.h>
+#include <libhexagonrpc/error.h>
+#include <libhexagonrpc/hexagonrpc.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "../hexagonrpcd/apps_std.h"
+#include "../hexagonrpcd/interface/adsp_listener.h"
+#include "../hexagonrpcd/interface/apps_std.h"
+#include "../hexagonrpcd/listener.h"
+#include "../hexagonrpcd/rpcd_builder.h"
+
+/*
+ * Drive run_fastrpc_listener() through a scripted remote side. A refused
+ * request must be answered with its error and no output buffers, and the
+ * listener must then fetch the next request instead of returning.
+ */
+
+struct step {
+	/* What the listener must reply to the previous request. */
+	uint32_t expect_result;
+	uint32_t expect_outbufs_len;
+	/* The next request, or none to tear the tunnel down. */
+	int last;
+	uint32_t handle;
+	uint32_t sc;
+	uint32_t method;
+};
+
+static const struct step script[] = {
+	/* The first call carries no reply. */
+	{ 0xffffffff, 0, 0, 1, APPS_STD_FOPEN_WITH_ENV_FD_SC, 37 },
+	/* Unknown method: error, no output, keep going. */
+	{ AEE_EUNSUPPORTED, 0, 0, 1, APPS_STD_FOPEN_WITH_ENV_FD_SC, 36 },
+	/* Method 36 on an absent file: ENOENT and the { fd, len } buffer. */
+	{ ENOENT, 16, 0, 7, APPS_STD_FOPEN_WITH_ENV_FD_SC, 36 },
+	/* Unknown handle. */
+	{ AEE_EUNSUPPORTED, 0, 0, 1, REMOTE_SCALARS_MAKE(31, 5, 2), 36 },
+	/* Wrong scalar shape. */
+	{ AEE_EBADPARM, 0, 1, 0, 0, 0 },
+};
+
+static size_t steps;
+
+static void fail(const char *message)
+{
+	fprintf(stderr, "test_listener_refusal: step %zu: %s\n", steps, message);
+	exit(1);
+}
+
+static size_t encode_request(char *wire, size_t capacity, uint32_t method)
+{
+	static const char *const strings[] = {
+		"ADSP_LIBRARY_PATH", ";", "absent.so", "r",
+	};
+	uint32_t primary[5];
+	const void *bufs[5];
+	uint32_t lens[5];
+	size_t off = 0, i;
+	uint32_t le;
+
+	primary[0] = htole32(method);
+	for (i = 0; i < 4; i++)
+		primary[i + 1] = htole32(strlen(strings[i]) + 1);
+
+	bufs[0] = primary;
+	lens[0] = sizeof(primary);
+	for (i = 0; i < 4; i++) {
+		bufs[i + 1] = strings[i];
+		lens[i + 1] = strlen(strings[i]) + 1;
+	}
+
+	for (i = 0; i < 5; i++) {
+		if (off + 16 + lens[i] > capacity)
+			fail("request does not fit");
+
+		le = htole32(lens[i]);
+		memcpy(&wire[off], &le, sizeof(le));
+		off += sizeof(le);
+
+		if (off & 7) {
+			memset(&wire[off], 0, 8 - (off & 7));
+			off += 8 - (off & 7);
+		}
+
+		memcpy(&wire[off], bufs[i], lens[i]);
+		off += lens[i];
+	}
+
+	return off;
+}
+
+static void check_fd_reply(const char *outbufs)
+{
+	uint32_t size;
+	int32_t out[2];
+
+	memcpy(&size, outbufs, sizeof(size));
+	memcpy(out, &outbufs[8], sizeof(out));
+	if (le32toh(size) != 8 || out[0] != -1 || out[1] != 0)
+		fail("method 36 reply is not { fd = -1, len = 0 }");
+}
+
+/* The remote side of adsp_listener: init2, then one next2 per step. */
+int hexagonrpc(const struct hrpc_method_def_interp4 *def,
+	       int fd, uint32_t handle, ...)
+{
+	const struct step *step;
+	uint32_t ret_result, ret_outbufs_len, inbufs_size;
+	uint32_t *rctx, *req_handle, *sc, *inbufs_len;
+	const char *ret_outbufs;
+	char *inbufs;
+	va_list ap;
+
+	if (def == &adsp_listener_init2_def)
+		return 0;
+	if (def != &adsp_listener_next2_def)
+		fail("unexpected remote call");
+	if (steps >= HRPC_ARRAY_SIZE(script))
+		fail("listener asked for more requests than scripted");
+
+	va_start(ap, handle);
+	va_arg(ap, uint32_t);
+	ret_result = va_arg(ap, uint32_t);
+	ret_outbufs_len = va_arg(ap, uint32_t);
+	ret_outbufs = va_arg(ap, const char *);
+	rctx = va_arg(ap, uint32_t *);
+	req_handle = va_arg(ap, uint32_t *);
+	sc = va_arg(ap, uint32_t *);
+	inbufs_len = va_arg(ap, uint32_t *);
+	inbufs_size = va_arg(ap, uint32_t);
+	inbufs = va_arg(ap, char *);
+	va_end(ap);
+
+	step = &script[steps];
+	if (ret_result != step->expect_result)
+		fail("listener replied with an unexpected result");
+	if (ret_outbufs_len != step->expect_outbufs_len)
+		fail("listener replied with unexpected output buffers");
+	if (ret_outbufs_len == 16)
+		check_fd_reply(ret_outbufs);
+
+	steps++;
+	if (step->last)
+		return AEE_EBADSTATE;
+
+	*rctx = steps;
+	*req_handle = step->handle;
+	*sc = step->sc;
+	*inbufs_len = encode_request(inbufs, inbufs_size, step->method);
+
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	struct fastrpc_interface *ifaces[2];
+	int ret;
+
+	if (argc != 2)
+		return 2;
+	if (mkdir(argv[1], 0700) && access(argv[1], F_OK))
+		return 3;
+
+	ifaces[0] = NULL;
+	ifaces[1] = fastrpc_apps_std_init(construct_root_dir(argv[1], "adsp"));
+	if (ifaces[1] == NULL)
+		fail("could not create the apps_std interface");
+
+	ret = run_fastrpc_listener(-1, HRPC_ARRAY_SIZE(ifaces), ifaces);
+	if (steps != HRPC_ARRAY_SIZE(script))
+		fail("listener stopped before the tunnel was torn down");
+	if (ret == 0)
+		fail("a torn-down tunnel was reported as success");
+
+	return 0;
+}
-- 
2.43.0

