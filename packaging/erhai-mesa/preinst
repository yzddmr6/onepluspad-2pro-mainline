#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e
case "$1" in
install | upgrade)
    for ICD in /usr/share/vulkan/icd.d/freedreno_icd.json \
               /usr/share/vulkan/icd.d/freedreno_icd.aarch64.json; do
        dpkg-divert --package erhai-mesa --add --rename --divert "$ICD.distrib" "$ICD"
    done
    ;;
esac
