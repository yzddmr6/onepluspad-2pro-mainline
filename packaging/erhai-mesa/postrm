#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e
case "$1" in
remove | disappear | abort-install)
    for ICD in /usr/share/vulkan/icd.d/freedreno_icd.json \
               /usr/share/vulkan/icd.d/freedreno_icd.aarch64.json; do
        if [ "$(dpkg-divert --listpackage "$ICD")" = erhai-mesa ]; then
            dpkg-divert --package erhai-mesa --remove --rename --divert "$ICD.distrib" "$ICD"
        fi
    done
    ;;
esac
