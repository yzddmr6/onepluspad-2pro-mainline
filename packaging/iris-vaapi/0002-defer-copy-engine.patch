Subject: [PATCH] va: defer copy-engine threads until context creation

Capability probes must stay thread-free for Chromium GPU sandbox startup.
Keep the existing GPU/CPU fallback when an actual context is requested.
Source: qualcomm-iris-vaapi f587b14e6b22955c7250a45ff5f43588bbce2114
License: MIT

--- a/src/va/driver.cc
+++ b/src/va/driver.cc
@@ -180,12 +180,11 @@
         return VA_STATUS_ERROR_OPERATION_FAILED;
     }
     d->render_fd = render_fd_of(ctx);
-    if (d->options.copy_mode == iris::CopyMode::Gpu)
-        d->copier = iris::make_gpu_copy(d->render_fd);
-    if (!d->copier)
-        d->copier = iris::make_cpu_copy();
-    d->trace("va init node=%s render_fd=%d copy=%s profiles=%zu", d->capabilities.node.c_str(), d->render_fd,
-        d->copier->name(), d->capabilities.profiles.size());
+    // Capability enumeration runs before browser sandbox initialization.
+    // Creating an EGL copy engine here starts Mesa worker threads and can
+    // prevent Chromium from installing its GPU seccomp policy.
+    d->trace("va init node=%s render_fd=%d copy=deferred profiles=%zu", d->capabilities.node.c_str(),
+        d->render_fd, d->capabilities.profiles.size());
 
     ctx->version_major = VA_MAJOR_VERSION;
     ctx->version_minor = VA_MINOR_VERSION;
--- a/src/va/picture.cc
+++ b/src/va/picture.cc
@@ -79,6 +79,14 @@
             auto it = d.configs.find(config);
             iris::require(it != d.configs.end(), "invalid config", VA_STATUS_ERROR_INVALID_CONFIG);
             cfg = it->second;
+            // Serialize the first copy-engine creation with other contexts.
+            // Do not start a GPU worker during vaInitialize/profile probing.
+            if (!d.copier) {
+                if (d.options.copy_mode == iris::CopyMode::Gpu)
+                    d.copier = iris::make_gpu_copy(d.render_fd);
+                if (!d.copier)
+                    d.copier = iris::make_cpu_copy();
+            }
         }
         auto c = std::make_shared<Context>();
         c->profile = cfg.profile;
