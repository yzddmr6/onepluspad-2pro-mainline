# The shared GNOME Settings Daemon owns the power key.
# Leave idle blanking, dimming and automatic suspend at distribution defaults.
[org.gnome.settings-daemon.plugins.power]
# Lock by default; the Settings power panel can change the action.
power-button-action='lock'

[org.gnome.desktop.screensaver]
lock-enabled=true

[org.gnome.shell]
enabled-extensions=['piano-osk-guard@io.github.piano']
