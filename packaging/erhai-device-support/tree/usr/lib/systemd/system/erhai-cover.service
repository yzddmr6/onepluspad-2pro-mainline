[Unit]
Description=Ignore touch input while the cover is closed
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/sbin/erhai-cover
ExecStopPost=/usr/sbin/erhai-cover --release
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-input r

[Install]
WantedBy=multi-user.target
