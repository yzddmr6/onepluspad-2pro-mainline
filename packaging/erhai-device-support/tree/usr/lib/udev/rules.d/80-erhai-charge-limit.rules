# UPower persists the user's GNOME battery-health choice; disabled by default.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="qcom-battmgr-bat", TEST=="charge_control_start_threshold", TEST=="charge_control_end_threshold", ENV{CHARGE_LIMIT}="75,80"
