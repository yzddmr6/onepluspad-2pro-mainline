#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e

SLEEP_TARGETS='sleep.target suspend.target hibernate.target hybrid-sleep.target'
BT_UNITS='erhai-bt-address-generate.service erhai-bt-address.service'
WIFI_UNITS='erhai-wifi-address-generate.service'
CHASSIS_UNIT=erhai-chassis.service
IDENTITY_UNIT=erhai-physical-platform.service
ASIDE=/var/lib/erhai/switch/pre-deb

if command -v dpkg-maintscript-helper >/dev/null 2>&1; then
	for file in /etc/dconf/profile/gdm \
		/etc/dconf/db/erhai-greeter.d/00-power-key \
		/etc/dconf/db/erhai-greeter.d/locks/power-key; do
		dpkg-maintscript-helper rm_conffile "$file" 0.1.9~ -- "$@"
	done
	dpkg-maintscript-helper mv_conffile \
		/etc/systemd/logind.conf.d/90-erhai-stopgap.conf \
		/etc/systemd/logind.conf.d/90-erhai-power.conf \
		0.1.6~ -- "$@"
fi

case "$1" in
configure)
	# This migration also runs on ordinary upgrades that omit erhai-debug.
	/usr/libexec/erhai-retire-legacy-debug
	# Before there was a package the switcher was copied into /usr/local/sbin
	# by hand, and /usr/local/sbin comes first on root's PATH. A copy left
	# there would keep shadowing the packaged one, so an upgrade would install
	# a new switcher and the old one would still be what runs -- and what runs
	# writes boot partitions. Move an *unpackaged* copy out of the way rather
	# than delete it: it is somebody's file, it just may not stay on PATH.
	for prog in erhai-switch erhai-switch-install-ubuntu-images; do
		stale=/usr/local/sbin/$prog
		[ -e "$stale" ] || continue
		dpkg-query -S "$stale" >/dev/null 2>&1 && continue
		mkdir -p "$ASIDE"
		if mv -f "$stale" "$ASIDE/$prog"; then
			echo "erhai-device-support: $stale predates this package and shadows" \
			     "/usr/sbin/$prog; moved to $ASIDE/$prog" >&2
		fi
	done

	# The Bluetooth address units. Both are WantedBy=bluetooth.service and
	# ordered before it, because the management interface takes a public
	# address only while the controller is still unconfigured and powered
	# down. Nothing here starts bluetooth.service or changes its state.
	#
	# The Wi-Fi address unit only writes the address down; the udev rule is
	# what puts it on the interface, because that is the only hook ordered
	# ahead of NetworkManager.
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper unmask erhai-power-key@.service >/dev/null 2>&1 || true
		for unit in $BT_UNITS $WIFI_UNITS $CHASSIS_UNIT $IDENTITY_UNIT; do
			deb-systemd-helper unmask "$unit" >/dev/null 2>&1 || true
			deb-systemd-helper enable "$unit" >/dev/null 2>&1 || true
		done
	elif command -v systemctl >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		systemctl enable --quiet $BT_UNITS $WIFI_UNITS $CHASSIS_UNIT $IDENTITY_UNIT || true
	fi

	# udevd watches the rule directories and reloads on its own, but an
	# explicit reload is what makes that a guarantee rather than a timing
	# assumption -- and this package's rule has to be in effect before the
	# radio's next add event, not eventually.
	if command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload-rules >/dev/null 2>&1 || true
		# Apply the display retention workaround to an already-bound MDSS.
		# Replaying only this platform change leaves network devices alone.
		udevadm trigger --action=change --subsystem-match=platform \
			--sysname-match=ae00000.display-subsystem || true
	fi

	# Suspend used to blank this tablet until a long power-key press, so an
	# earlier version of this package masked the four sleep targets. It
	# suspends and resumes now, so take the masks off again -- and do it
	# whatever version is being upgraded from, because a mask this package
	# put there is this package's to remove.
	if command -v systemctl >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		systemctl unmask --quiet $SLEEP_TARGETS || true
		[ -d /run/systemd/system ] && systemctl daemon-reload || true
	fi
	# logind reads its drop-ins at start, so the power-key setting takes
	# effect at the next boot; nothing here restarts logind, which would end
	# the user's session mid-upgrade.
	if command -v glib-compile-schemas >/dev/null 2>&1; then
		glib-compile-schemas /usr/share/glib-2.0/schemas || true
	fi
	# Retire the generated cache from the superseded greeter-only policy.
	# The new handler uses SetActive for GDM and Lock for user sessions.
	rm -f /etc/dconf/db/erhai-greeter
	if command -v update-desktop-database >/dev/null 2>&1; then
		update-desktop-database -q /usr/share/applications || true
	fi

	# Give the controller its address now rather than at the next boot: an
	# install is also how a running system gets Bluetooth for the first time.
	# Both units are oneshot and bounded, and neither pulls in or restarts
	# bluetooth.service. A failure is not a reason to fail the transaction --
	# the next boot runs them again.
	if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		systemctl start $BT_UNITS $WIFI_UNITS $CHASSIS_UNIT || true
		for path in /sys/class/input/event*/device/name; do
			[ -f "$path" ] || continue
			[ "$(cat "$path")" = pmic_pwrkey ] || continue
			event=${path#/sys/class/input/}
			event=${event%%/*}
			# An existing input node needs the new systemd udev tag before
			# the unit's device dependency can become active.
			udevadm trigger --action=add --subsystem-match=input \
				--sysname-match="$event" || true
			systemctl --no-block start "erhai-power-key@$event.service" || true
		done
	fi

	# Wi-Fi is the other half of the same idea, but it cannot be applied the
	# same way: mac80211 takes an address only on an interface that is not
	# running, and taking this one down would drop whatever the user is
	# connected over -- possibly the connection this very upgrade came over.
	# So record the address now and let the udev rule apply it at the next
	# boot; the program says so rather than failing.
	if command -v erhai-wifi-address >/dev/null 2>&1; then
		erhai-wifi-address --apply || true
	fi

	# Root filesystems before 0.3.0 kept the Ubuntu ISO's cdrom.sources, which
	# names the installation medium as a package source. An installed system
	# has no /cdrom, so apt update fails on it. Remove that one file, and only
	# while it points at /cdrom; every other source stays as it is.
	cdrom=/etc/apt/sources.list.d/cdrom.sources
	if [ -f "$cdrom" ] && grep -qx 'URIs: file:///cdrom' "$cdrom"; then
		rm -f "$cdrom"
	fi
	;;
esac

exit 0
