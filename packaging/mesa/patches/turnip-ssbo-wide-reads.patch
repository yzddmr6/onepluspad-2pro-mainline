+/* NIR alignment is relative to the SSBO base.  Vulkan permits a 4-byte
+ * base even for an 8/16-byte vector.  The typed hardware path rounds that base
+ * down to its format size, so select it only when the real base is aligned. */
+static bool
+lower_wide_ssbo_alignment(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_ssbo ||
+       intr->def.bit_size != 32 || intr->def.num_components < 2 ||
+       !(nir_intrinsic_access(intr) & ACCESS_CAN_REORDER))
+      return false;
+   unsigned alignment = ir3_ssbo_typed_alignment(intr);
+   if (alignment == 4)
+      return false;
+
+   auto state = static_cast<const lower_ssbo_address_size_state *>(data);
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *base = build_ssbo_global_addr(
+      b, get_ssbo_bindless(intr), state->shader,
+      state->load_shader_consts_via_preamble, state->const_allocs, 0);
+   nir_def *low = nir_unpack_64_2x32_split_x(b, base);
+   nir_if *nif = nir_push_if(b, nir_ieq_imm(b, nir_iand_imm(b, low, alignment - 1), 0));
+   auto wide = nir_instr_as_intrinsic(nir_instr_clone(b->shader, &intr->instr));
+   nir_builder_instr_insert(b, &wide->instr);
+   nir_push_else(b, nif);
+   auto fallback = nir_instr_as_intrinsic(nir_instr_clone(b->shader, &intr->instr));
+   /* Conservative access metadata keeps the exact-width untyped LDIB fallback. */
+   nir_intrinsic_set_access(fallback, (gl_access_qualifier)(nir_intrinsic_access(fallback) & ~ACCESS_CAN_REORDER));
+   nir_builder_instr_insert(b, &fallback->instr);
+   nir_pop_if(b, nif);
+   nir_def *value = nir_if_phi(b, &wide->def, &fallback->def);
+   nir_def_rewrite_uses(&intr->def, value);
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+static bool
+tu_nir_lower_wide_alignment(nir_shader *shader, void *state)
+{
+   bool progress = false;
+   nir_foreach_function_impl(impl, shader) {
+      struct util_dynarray originals;
+      util_dynarray_init(&originals, NULL);
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic)
+               util_dynarray_append(&originals, nir_instr_as_intrinsic(instr));
+         }
+      }
+      nir_builder b = nir_builder_create(impl);
+      bool changed = false;
+      util_dynarray_foreach(&originals, nir_intrinsic_instr *, intr)
+         changed |= lower_wide_ssbo_alignment(&b, *intr, state);
+      util_dynarray_fini(&originals);
+      if (changed)
+         nir_progress(true, impl, nir_metadata_none);
+      progress |= changed;
+   }
+   return progress;
+}
+
