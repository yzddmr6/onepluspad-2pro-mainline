diff --git a/src/freedreno/ir3/ir3_compiler.h b/src/freedreno/ir3/ir3_compiler.h
index 2a581a2..568b560 100644
--- a/src/freedreno/ir3/ir3_compiler.h
+++ b/src/freedreno/ir3/ir3_compiler.h
@@ -23,6 +23,23 @@ BEGINC;
 struct ir3_ra_reg_set;
 struct ir3_shader;
 
+/* Maximum format alignment used by the exact-width decomposition, including
+ * a scalar prefix followed by a wider suffix (e.g. vec4.yzw). */
+static inline unsigned
+ir3_ssbo_typed_alignment(const nir_intrinsic_instr *intr)
+{
+   unsigned alignment = 4;
+   for (unsigned c = 0; c < intr->def.num_components; c++) {
+      for (unsigned w = 2; w <= 4; w *= 2) {
+         if (intr->def.num_components - c >= w &&
+             nir_intrinsic_align_mul(intr) >= w * 4 &&
+             (nir_intrinsic_align_offset(intr) + c * 4) % (w * 4) == 0)
+            alignment = MAX2(alignment, w * 4);
+      }
+   }
+   return alignment;
+}
+
 struct ir3_compiler_options {
    /* If true, promote UBOs (except for constant data) to constants using ldc.k
     * in the preamble. The driver should ignore everything in ubo_state except
@@ -46,6 +63,8 @@ struct ir3_compiler_options {
    bool storage_16bit;
    /* True if 8-bit descriptors are available. */
    bool storage_8bit;
+   /* Driver appends R32/RG32/RGBA32 aliases after the storage descriptors. */
+   bool typed_isam_ssbo;
 
    /* If base_vertex should be lowered in nir */
    bool lower_base_vertex;
