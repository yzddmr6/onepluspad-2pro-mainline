+      const unsigned aliases = 1 + ctx->compiler->options.storage_8bit +
+         (ctx->compiler->options.storage_16bit &&
+          !ctx->compiler->info->props.has_isam_v);
+      for (unsigned c = 0; c < intr->def.num_components;) {
