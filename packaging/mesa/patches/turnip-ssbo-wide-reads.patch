+         for (unsigned w = 4; w >= 2; w /= 2) {
+            if (intr->def.num_components - c >= w &&
+                nir_intrinsic_align_mul(intr) >= w * 4 &&
+                (nir_intrinsic_align_offset(intr) + c * 4) % (w * 4) == 0) {
+               width = w;
+               break;
+            }
+         }
+         unsigned shift = util_logbase2(width);
+         struct tex_src_info info = get_image_ssbo_samp_tex_src(
+            ctx, &intr->src[0], false, aliases + shift);
+         struct ir3_instruction *offset = coords;
+         if (imm_offset + c)
+            offset = ir3_ADD_U(b, offset, 0, create_immed(b, imm_offset + c), 0);
+         if (shift)
+            offset = ir3_SHR_B(b, offset, 0, create_immed(b, shift), 0);
+         struct ir3_instruction *xy = ir3_collect(b, offset, create_immed(b, 0));
+         struct ir3_instruction *sam =
+            emit_sam(ctx, OPC_ISAM, info, TYPE_U32, MASK(width), xy, NULL);
