Mesa 26.2.0: match Adreno 830 revision 1 with the speed bin supplied by drm/msm.

MSM_PARAM_CHIP_ID adds speedbin in bits 63:32 for GPUs without a legacy revn.
Use Mesa's existing wildcard fuse ID; this still matches the KGSL ID with zero
upper bits. The revision-0 entry already uses this convention. Based on the
MIT-licensed freedreno_devices.py at Mesa commit 9f0a761020bca92f2b07156a0621e5360cb8eca5.
The ROCKNIX 92a6fca6 SM8750 chip-ID patch independently includes this wildcard.
This local minimal change does not copy its redundant revision-0 KGSL entry.

--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -1342,7 +1342,7 @@
 
 add_gpus([
         GPUId(chip_id=0xffff44050000, name="Adreno (TM) 830"),
-        GPUId(chip_id=0x44050001, name="Adreno (TM) 830"), # KGSL
+        GPUId(chip_id=0xffff44050001, name="Adreno (TM) 830"),
     ], A6xxGPUInfo(
         CHIP.A8XX,
         [a7xx_base, a7xx_gen3, a8xx_base, a8xx_gen1],

--- a/src/mesa/main/context.c
+++ b/src/mesa/main/context.c
@@ -1062,9 +1062,10 @@
 
    ctx->FirstTimeCurrent = GL_TRUE;
 
-   simple_mtx_lock(&ctx->Shared->Mutex);
-   list_addtail(&ctx->SharedLink, &ctx->Shared->Contexts);
-   simple_mtx_unlock(&ctx->Shared->Mutex);
+   /* Publish only after the state tracker is fully initialized.  Keep an
+    * empty link so context creation failures can use normal teardown.
+    */
+   list_inithead(&ctx->SharedLink);
    ctx->ReleaseResources = UTIL_DYNARRAY_INIT;
 
    return GL_TRUE;
--- a/src/mesa/state_tracker/st_context.c
+++ b/src/mesa/state_tracker/st_context.c
@@ -805,6 +805,13 @@
    if (!st) {
       _mesa_free_context_data(ctx, true);
       align_free(ctx);
+   } else {
+      /* Other contexts walk this list while releasing shared buffers and
+       * access ctx->st->pipe and ReleaseResources under Shared->Mutex.
+       */
+      simple_mtx_lock(&ctx->Shared->Mutex);
+      list_addtail(&ctx->SharedLink, &ctx->Shared->Contexts);
+      simple_mtx_unlock(&ctx->Shared->Mutex);
    }
 
    return st;
